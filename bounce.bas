90 DIM T(20)
100 PRINT "THIS SIMULATION LETS YOU SPECIFY THE INITIAL VELOCITY"
110 PRINT "OF A BALL THROWN STRAIGHT UP, AND THE COEFFICIENT OF"
120 PRINT "ELASTICITY OF THE BALL. PLEASE USE A DECIMAL FRACTION"
130 PRINT "LESS THAN 1."
131 PRINT
132 PRINT "YOU ALSO SPECIFY THE TIME INCREMENT TO BE USED IN"
133 PRINT "IN 'STROBING' THE BALL'S FLIGHT. TRY .1 INITIALLY."
134 PRINT
135 PRINT "TIME INCREMENT (SEC)";
136 INPUT S2
140 PRINT
150 PRINT "VELOCITY (FPS)";
160 INPUT V
165 PRINT
170 PRINT "COEFFICIENT";
180 INPUT C
184 PRINT
185 PRINT "FEET"
186 PRINT
187 S1=INT(70/(V/(16*S2)))
190 FOR I=1 TO S1
200 T(I)=V*C^(I-1)/16
210 NEXT I
220 FOR H=INT(-16*(V/32)^2+V^2/32+.5) TO 0 STEP -.5
221 K=0
222 IF INT(H)<>H THEN 225
223 PRINT H;
224 N=H:GOSUB 1100:K=D+2
225 L=0:Q=0
230 FOR I=1 TO S1
240 FOR T=0 TO T(I) STEP S2
245 L=L+S2:Q=Q+1
250 Y=.5*(-32)*T^2+V*C^(I-1)*T
252 IF ABS(H-Y)>.25 THEN 270
260 P=Q:GOSUB 1000
262 PRINT "O";:K=K+1
270 NEXT T
275 T=T(I+1)/2
276 IF -16*T^2+V*C^(I-1)*T<H THEN 290
280 NEXT I
290 PRINT
300 NEXT H
310 K=0:P=1:GOSUB 1000
320 FOR I=1 TO INT(L+1)/S2+1
330 PRINT ".";:K=K+2
340 NEXT I
350 PRINT
352 PRINT
355 K=0:PRINT " 0";:K=2
360 FOR I=1 TO INT(L+.9995)
370 P=INT(I/S2):GOSUB 1000
380 PRINT I;:N=I:GOSUB 1100:K=K+D+2
390 NEXT I
400 PRINT
410 K=0:P=INT(INT(L+1)/(2*S2)-2)
412 GOSUB 1000
414 PRINT "SECONDS"
420 PRINT
430 GOTO 135
440 END
1000 REM SPACE TO ABSOLUTE COLUMN P
1010 P=INT(P)
1020 IF P<1 THEN 1060
1030 IF K>=P-1 THEN 1060
1040 PRINT " ";:K=K+1:GOTO 1030
1060 RETURN
1100 REM COUNT DIGITS IN NONNEGATIVE NUMBER N
1110 D=1:X=INT(N)
1120 IF X<10 THEN 1160
1130 X=INT(X/10)
1140 D=D+1:GOTO 1120
1160 RETURN

